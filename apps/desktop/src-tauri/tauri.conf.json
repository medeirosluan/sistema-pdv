{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sistema PDV",
  "version": "0.1.3",
  "identifier": "com.sistemapdv.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sistema PDV",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https: http://localhost:3000 ws://localhost:5173 ipc: http://ipc.localhost; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/medeirosluan/sistema-pdv/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5REJFMkY1QjRGQ0UzMTgKUldRWTQveTA5ZUxiR1NkSmhyNEc0K21YZUNsaHJNRTQ1bjZHbVg1NXZQZ2NvOWVFd1VwWStOUnoK"
    }
  }
}
