# Copie para .env.prod e ajuste antes do deploy:
#   cp .env.prod.example .env.prod
#
# Subir:  docker compose -f docker-compose.prod.yml up -d --build
# Logs:   docker compose -f docker-compose.prod.yml logs -f api

# Domínio (o Caddy emite HTTPS automaticamente). Para testar local: localhost
DOMAIN="seudominio.com"

# Banco
POSTGRES_USER="pdv"
POSTGRES_PASSWORD="troque-por-uma-senha-forte"
POSTGRES_DB="pdv"

# Role de runtime do app (sujeito ao RLS)
APP_DB_USER="pdv_app"
APP_DB_PASSWORD="troque-por-outra-senha-forte"

# Segredos (mínimo 24 caracteres, sem valores padrão)
JWT_SECRET="gere-um-segredo-forte-aleatorio-123456"
JWT_REFRESH_SECRET="gere-outro-segredo-forte-aleatorio-123456"

# CORS: domínio do site (o app desktop usa tauri)
CORS_ORIGINS="https://seudominio.com,http://tauri.localhost,tauri://localhost"

# Admin da plataforma (painel Admin)
PLATFORM_ADMIN_EMAILS="voce@seudominio.com"

# Asaas (deixe vazio para usar o provedor simulado)
ASAAS_API_KEY=""
ASAAS_BASE_URL="https://api.asaas.com/v3"
ASAAS_WEBHOOK_TOKEN=""

# Backup (dump diário do banco em ./backups)
BACKUP_SCHEDULE="@daily"
BACKUP_KEEP_DAYS="7"
BACKUP_KEEP_WEEKS="4"
BACKUP_KEEP_MONTHS="6"

# URL pública do app (links de e-mail)
APP_URL="https://seudominio.com"

# E-mail (SMTP) — sem SMTP, os e-mails são apenas registrados no log
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Sistema PDV <nao-responda@sistemapdv.com>"
