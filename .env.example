# Banco de dados (usado pelo Prisma e pelo backend)
DATABASE_URL="postgresql://pdv:pdv@localhost:5432/pdv?schema=public"
# Conexão de runtime do app (role NÃO-superuser, sujeita ao RLS).
# Sem isso, o RLS é ignorado (superuser ignora RLS).
APP_DATABASE_URL="postgresql://pdv_app:pdv_app@localhost:5432/pdv?schema=public"

# API
PORT=3000
NODE_ENV=development

# Origens permitidas (CORS) — separe por vírgula. Em produção, use seu domínio.
CORS_ORIGINS="http://localhost:5173,http://tauri.localhost,tauri://localhost"

# Autenticação
JWT_SECRET="troque-por-um-segredo-forte-e-aleatorio"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque-por-outro-segredo-forte"
JWT_REFRESH_EXPIRES_IN="7d"

# Administradores da plataforma (SaaS) — e-mails separados por vírgula
PLATFORM_ADMIN_EMAILS="admin@seudominio.com"

# Pagamentos / assinatura (Asaas) — sem a chave, usa o provedor simulado
ASAAS_API_KEY=""
ASAAS_BASE_URL="https://api-sandbox.asaas.com/v3"
ASAAS_WEBHOOK_TOKEN=""

# Frontend (Vite) — URL base da API
VITE_API_URL="http://localhost:3000"

# Loja fixa no login/app desktop (opcional; vazio = digitar a loja)
VITE_TENANT_SLUG=""

# URL pública do app (usada em links de e-mail, ex.: redefinição de senha)
APP_URL="http://localhost:5173"

# E-mail (SMTP) — sem SMTP, os e-mails são registrados no console (dev)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Sistema PDV <nao-responda@sistemapdv.com>"
